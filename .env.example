# ==============================================
# Wizard Tracker Environment Configuration Example
# ==============================================
# Copy this file to .env and customize for your environment

# Frontend Build Variables (used during Docker build)
VITE_APP_VERSION=1.10.2
VITE_BUILD_DATE=2025-01-01T00:00:00Z

# Backend Runtime Variables
# ==============================================

# MongoDB Connection
MONGO_URI=mongodb://mongodb:27017/wizard-tracker

# JWT Secret - MUST BE CHANGED IN PRODUCTION!
# Generate: node -e "console.debug(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# How long an auth token stays valid, in days (default: 90).
# Tokens are renewed automatically once past half their life, so an active user
# stays signed in; lower this only if you want sessions to end sooner.
JWT_EXPIRES_IN_DAYS=90

# Server Configuration
NODE_ENV=production
PORT=5000

# Upload Service Settings
UPLOAD_CONCURRENCY=5
REPLACE_EXISTING_GAMES=false

# MongoDB Admin Interface Credentials
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin123
